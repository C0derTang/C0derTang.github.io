{
  "name": "c0dertang-site",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Christopher Tang — a rainy rice farm you scroll through",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "bench": "BENCH=1 playwright test --project=bench",
    "clean": "rm -rf dist node_modules/.tmp test-results playwright-report"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "animejs": "^4.5.0",
    "lenis": "^1.3.26",
    "postprocessing": "6.39.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.0",
    "@types/three": "0.185.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
